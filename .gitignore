# Allowlist: track the original ZedsTekkitOverhaul project only.
# Place at the root of the existing MDK-1.2.5 workspace.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/.github/
!/docs/
!/zto-tools/
!/src/

# The MCP source tree includes third-party code. Track only our namespace.
/src/*
!/src/minecraft/
/src/minecraft/*
!/src/minecraft/zed/

# No compiled output, redistributed mods, logs or local credentials.
*.class
*.jar
*.zip
*.log
*.key
*.pem
.env
.env.*
!.env.example
